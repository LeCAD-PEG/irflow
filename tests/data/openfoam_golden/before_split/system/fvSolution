FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system/heater";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(h|e)"
    {
        solver           PCG;
	preconditioner   DIC;
        smoother         symGaussSeidel;
        tolerance        0.01;
        relTol           0.05;
        nPreSweeps       2;
        nPostSweeps      2;
        nFinestSweeps    2;
        cacheAgglomeration true;
        agglomerator     faceAreaPair;
        mergeLevels      1;
    }

    "(h|e)Final"
    {
        $h;
        relTol           0;
    }
}

PIMPLE
{
	nNonOrthogonalCorrectors 1;  // mesh has faces up to 89.7 degrees non-orthogonality
}


